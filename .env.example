# Sauce Labs (only needed when running test:sauce)
SAUCE_USERNAME=your_username
SAUCE_ACCESS_KEY=your_access_key

# Sauce app references (set after upload)
SAUCE_ANDROID_APP=storage:filename=sample.apk
SAUCE_IOS_APP=storage:filename=sample.app

# Optional: override device names in Sauce runs
SAUCE_ANDROID_DEVICE="Google Pixel 6 GoogleAPI Emulator"
SAUCE_ANDROID_PLATFORM_VERSION="13"
SAUCE_IOS_DEVICE="iPhone 14 Simulator"
SAUCE_IOS_PLATFORM_VERSION="16"

# Optional: specify Sauce data center region (default is us-west-1)
SAUCE_REGION=us-west-1

# Optional: send explicit pass/fail result back to Sauce from afterTest hook.
# Keep false for local Docker/Appium runs to avoid unsupported execute warnings.
ENABLE_SAUCE_JOB_RESULT=false

# Enable running on Sauce Labs 
RUN_ON_SAUCE=true